---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <p>© {year} {SITE.siteName}. Unofficial fan site, not affiliated with the game publisher.</p>
    <div class="links">
      <a href="/about/">About</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/contact/">Contact Us</a>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  a {
    color: var(--muted);
  }
</style>
