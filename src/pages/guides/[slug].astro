---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const path = `/guides/${guide.id}/`;

// 内链：列出其他攻略页（首页-内页、内页-内页密切内链）
const others = (await getCollection('guides')).filter((g) => g.id !== guide.id);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: guide.data.pubDate.toISOString(),
    dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
    mainEntityOfPage: new URL(path, Astro.site).href,
    // Discover 就绪：author/image 有值才输出（config/site.ts 与 frontmatter 控制）
    ...(SITE.author ? { author: { '@type': 'Person', name: SITE.author } } : {}),
    ...(guide.data.image || SITE.ogImage
      ? { image: new URL(guide.data.image ?? SITE.ogImage, Astro.site).href }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: new URL('/guides/', Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: guide.data.title },
    ],
  },
];
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={path}
  jsonLd={jsonLd}
  image={guide.data.image}
>
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/guides/">Guides</a></nav>
  <article>
    <h1>{guide.data.title}</h1>
    <Content />
  </article>

  {
    others.length > 0 && (
      <aside>
        <h2>Related Guides</h2>
        <ul>
          {others.map((g) => (
            <li>
              <a href={`/guides/${g.id}/`}>{g.data.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</BaseLayout>

<style>
  .breadcrumb {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 1rem;
  }
</style>
